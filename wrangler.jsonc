{
  "name": "harmattan-sessions",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harmattan_sessions",
      // OWNER: replace with real id after `wrangler d1 create harmattan_sessions`
      "database_id": "4c64c534-b194-4e1a-8125-462508e6e915"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RL",
      // OWNER: replace with real id after `wrangler kv namespace create RL`
      "id": "0fb2685e64d4406685650b50db8e59e0"
    }
  ]
}
