{
  "name": "harmattan-sessions",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // @astrojs/cloudflare v13 emits a Workers-with-Static-Assets bundle.
  // Deploy via `npm run build && npx wrangler deploy` (uses the adapter's
  // generated dist/server/wrangler.json via .wrangler/deploy/config.json).
  // Local dev (`astro dev`) reads the bindings below via the Cloudflare Vite plugin.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harmattan_sessions",
      "database_id": "4c64c534-b194-4e1a-8125-462508e6e915"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RL",
      "id": "0fb2685e64d4406685650b50db8e59e0"
    }
  ],
  "routes": [
    { "pattern": "hs.ohwpstudios.org", "custom_domain": true }
  ]
}
