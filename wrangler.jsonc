{
  "name": "harmattan-sessions",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // @astrojs/cloudflare v13 emits a Workers-with-Static-Assets bundle into ./dist;
  // deploy via `cd dist/server && wrangler deploy` (NOT `wrangler pages deploy`).
  // `pages_build_output_dir` is kept only so `astro dev` recognises the local-dev config.
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harmattan_sessions",
      "database_id": "4c64c534-b194-4e1a-8125-462508e6e915"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RL",
      "id": "0fb2685e64d4406685650b50db8e59e0"
    }
  ],
  "routes": [
    { "pattern": "hs.ohwpstudios.org", "custom_domain": true }
  ]
}
